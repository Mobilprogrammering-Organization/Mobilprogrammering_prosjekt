{
  "expo": {
    "name": "mobilprogrammering_prosjekt",
    "slug": "mobilprogrammering_prosjekt",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/checkpoint/checkpoint.png",
    "scheme": "mobilprogrammeringprosjekt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/checkpoint/checkpoint.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/checkpoint/checkpoint.png",
        "backgroundImage": "./assets/images/checkpoint/checkpoint.png",
        "monochromeImage": "./assets/images/checkpoint/checkpoint.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/checkpoint/checkpoint.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/checkpoint/checkpoint.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
      //"expo-asset",
      //{
      //"assets": ["./assets/images/checkpoint/checkpoint.png"]
      //}
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
